    "qa": "pnpm --filter './qa-playwright' test"
  },
  "keywords": [
    "workspace",
    "collaboration",
    "ai",
    "real-time",
    "next.js",
    "tauri",
    "cloudflare-workers"
  ],
  "author": "DevCraftXCoder"
}
